# ============================================================
# ONEGATE ENTERPRISE ENVIRONMENT CONFIGURATION
# ============================================================

# Server Settings
PORT=3000
NODE_ENV=development

# Authentication & Security
JWT_SECRET=
BCRYPT_ROUNDS=12
COMPANY_EMAIL_DOMAIN=company.com
DEMO_MODE=true
# Optional: stable password for demo accounts on a PRIVATE demo box (min 12 chars). Leave unset to generate one.
DEMO_PASSWORD=

# Zenmux AI LLM Configuration (OpenAI-compatible)
ZENMUX_API_KEY=
ZENMUX_BASE_URL=https://zenmux.ai/api/v1
ZENMUX_PRIMARY_MODEL=dots-studio/dots3-note-prev

# Python ML Microservice (FastAPI + PyTorch DistilBERT)
ML_SERVICE_URL=http://127.0.0.1:8000

# --- OneGate SME agent (all optional; the SME demo needs none of these) ---
# Any OpenAI-compatible endpoint turns on LLM tool-calling (falls back to ZENMUX_* above).
SME_LLM_API_KEY=
SME_LLM_BASE_URL=
SME_LLM_MODEL=
# SME_LLM=off forces the deterministic planner even when a key is set.
# Autopilot run interval in minutes (default 1440 = daily; 0 disables the schedule).
SME_AUTOPILOT_INTERVAL_MIN=1440
# sms = do not return one-time codes in API responses (production). Default: sandbox delivery.
SME_STEPUP_DELIVERY=
