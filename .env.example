# Server Settings
PORT=3000
NODE_ENV=development

# Authentication & Security
JWT_SECRET=
BCRYPT_ROUNDS=12
COMPANY_EMAIL_DOMAIN=company.com
DEMO_MODE=true

# Zenmux AI LLM Configuration (OpenAI-compatible)
ZENMUX_API_KEY=
ZENMUX_BASE_URL=https://zenmux.ai/api/v1
